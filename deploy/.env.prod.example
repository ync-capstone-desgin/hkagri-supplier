# 서버에서 복사해서 .env.prod로 사용한다: cp deploy/.env.prod.example .env.prod
# .env.prod는 Git에 올리지 않는다.

# 접속 주소 (도메인이 없으면 고정 IP 3.35.10.20 → 3-35-10-20.sslip.io 형식)
SITE_ADDRESS=3-35-10-20.sslip.io

# DB 비밀번호는 긴 임의 문자열로 바꾼다
DB_NAME=supplier
DB_USER=supplier
DB_PASSWORD=change-me-long-random

# 체험 계정(admin·manager1·manager2·viewer) 공통 비밀번호. README의 demo1234!와 다르게 정한다.
# DB가 처음 만들어질 때만 적용된다.
SEED_PASSWORD=change-me-too

# 첨부파일 하나의 최대 크기 (기본 20MB). 바꾸면 요청 전체 한도도 1MB쯤 크게 함께 바꾼다.
# FILE_MAX_SIZE=20MB
# FILE_MAX_REQUEST_SIZE=21MB

# 실제 메일 발송(Gmail SMTP). 아래를 비워두면 내부 Mailpit(메일 미발송)을 그대로 쓴다.
# 설정 방법은 deploy-aws.md 11장 참고.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=실제Gmail계정@gmail.com
# MAIL_PASSWORD=구글-앱-비밀번호(16자)
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=한국농산 협력업체 통합관리 <실제Gmail계정@gmail.com>
