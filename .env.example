# 복사해서 .env로 사용한다. .env는 Git에 올리지 않는다.
DB_NAME=supplier
DB_USER=supplier
DB_PASSWORD=supplier
# 시연 계정(admin, manager1, manager2, viewer) 공통 비밀번호
SEED_PASSWORD=demo1234!

# 실제 메일 발송(Gmail SMTP). 비워두면 기존처럼 로컬 Mailpit(인증 없음)을 쓴다.
# MAIL_USERNAME은 발신 Gmail 계정 주소, MAIL_PASSWORD는 일반 로그인 비밀번호가 아니라
# 구글 계정 2단계 인증 설정 후 발급받는 "앱 비밀번호"(16자)를 넣는다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=#이메일 주소@gmail.com
MAIL_PASSWORD=#발급받은16자리앱비밀번호
# Gmail은 발신 주소가 인증 계정과 같아야 한다. MAIL_USERNAME과 같은 Gmail 주소로 맞춘다.
MAIL_FROM=#한국농산 협력업체 통합관리 <이메일 주소@gmail.com>
# 위 값을 실제로 채웠을 때만 true로 켠다. Mailpit은 둘 다 지원하지 않는다.
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

