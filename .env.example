# 복사해서 .env로 사용한다. .env는 Git에 올리지 않는다.
DB_NAME=supplier
DB_USER=supplier
DB_PASSWORD=supplier
# 시연 계정(admin, manager1, manager2, viewer) 공통 비밀번호
SEED_PASSWORD=demo1234!

# 실제 메일 발송(Gmail SMTP). 아래 줄을 그대로 두면 로컬 Mailpit(인증 없음)을 쓴다.
# 실제로 보내려면 MAIL_ 로 시작하는 줄 맨 앞의 "# "를 지우고 값을 채운다.
# MAIL_USERNAME은 발신 Gmail 계정 주소, MAIL_PASSWORD는 일반 로그인 비밀번호가 아니라
# 구글 계정 2단계 인증 설정 후 발급받는 "앱 비밀번호"(16자)를 넣는다.
# Gmail은 발신 주소가 인증 계정과 같아야 하므로 MAIL_FROM의 주소도 같은 Gmail 주소로 맞춘다.
# 값에 공백이나 < > 가 들어가면 MAIL_FROM처럼 작은따옴표로 감싼다.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=앱비밀번호16자리
# MAIL_FROM='한국농산 협력업체 통합관리 <your-account@gmail.com>'
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
